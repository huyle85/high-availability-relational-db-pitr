FROM golang:1.22-bookworm AS builder

WORKDIR /src
RUN git clone --depth 1 --branch RELEASE.2024-01-18T22-51-28Z https://github.com/minio/minio.git . \
 && CGO_ENABLED=0 go build -trimpath -o /minio .

FROM debian:bookworm-slim
COPY --from=builder /minio /usr/local/bin/minio

EXPOSE 9000 9001
VOLUME ["/data"]

ENTRYPOINT ["minio"]